amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.12.3#/Taskfile.pkl"

local sources: Listing<String> = new {
  "src/**/*.rs"
  "crates/astscan-core/src/**/*.rs"
  "crates/astscan-core/tests/**/*.rs"
  "crates/astscan-core/csrc/**/*.c"
  "crates/astscan-core/Cargo.toml"
  "crates/astscan-core/README.md"
  "crates/astscan-core/build.rs"
  "tests/**/*.rs"
  "Cargo.toml"
  "Cargo.lock"
  "rust-toolchain.toml"
}

local build: Task = new {
  name = "build"
  description = "Release build of the astscan binary"
  cmd = "cargo build --release"
  inputs = sources
  outputs { "target/release/astscan" }
}

local test: Task = new {
  name = "test"
  description = "Unit tests and black-box CLI tests"
  cmd = "cargo test --release"
  inputs = sources
}

local lint: Task = new {
  name = "lint"
  description = "rustfmt check and clippy with warnings as errors"
  cmd = "cargo fmt --all --check && cargo clippy --workspace --release --all-targets -- -D warnings"
  inputs {
    ...sources
    "rustfmt.toml"
    "experiments/Cargo.toml"
    "experiments/src/**/*.rs"
  }
}

/// Compares every match with ast-grep's. Needs an ast-grep binary (AST_GREP)
/// and node; see tools/diff.mjs for the arguments after `--`.
local diff: Task = new {
  name = "diff"
  description = "Differential test against ast-grep: pkf run diff -- --rule rules.yml --cwd repo"
  cmd = "node tools/diff.mjs \"$@\""
  acceptsArgs = true
  cache = false
  deps { build }
}

local ci: Task = new {
  name = "ci"
  description = "Everything a change has to pass"
  deps { lint; test }
}

local secretlint: Task = new {
  name = "lint:secretlint"
  description = "Run secretlint against files in the diff about to be pushed"
  cmd =
    #"""
    set -euo pipefail
    upstream=$(git rev-parse --symbolic-full-name '@{push}' 2>/dev/null \
            || git rev-parse --symbolic-full-name '@{u}' 2>/dev/null \
            || true)
    emit_files() {
      if [ -n "$upstream" ]; then
        git diff --name-only --diff-filter=ACMR -z "${upstream}..HEAD"
      else
        git ls-files -z
      fi
    }
    if [ -z "$(emit_files | tr -d '\0')" ]; then
      exit 0
    fi
    emit_files | xargs -0 pnpm exec secretlint --
    """#
  cache = false
  inputs {
    ".secretlintrc.json"
    "package.json"
    "pnpm-lock.yaml"
  }
}

local prePush: Task = new {
  name = "pre-push"
  description = "Pre-push gate: secretlint over the outgoing diff"
  cmd = "echo pre-push ok"
  cache = false
  deps { secretlint }
}

tasks { build; test; lint; diff; ci; secretlint; prePush }
